import java.util.Scanner;
 
public class A_Square_String {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
 
        int t = sc.nextInt();
 
        while(t-- > 0){
            String s = sc.next();
            int n = s.length();
            boolean sq = true;
 
            if(n % 2 != 0){
                System.out.println("NO");
                continue;
            }
            else{
                for(int i = 0; i<n/2 ; i++){
                    if(s.charAt(i) != s.charAt(n/2+i)){
                        sq = false;
                    }
                }
            }
            if(sq) System.out.println("YES");
            else System.out.println("NO");
        }
        sc.close();
    }
}