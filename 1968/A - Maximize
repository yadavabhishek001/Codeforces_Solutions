import java.util.*;
 
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
 
        int t = sc.nextInt();
 
        while (t-- > 0) {
            int x = sc.nextInt();
 
            int smallestDiv = -1;
 
            for (int i = 2; i * i <= x; i++) {
                if (x % i == 0) {
                    smallestDiv = i;
                    break;
                }
            }
 
            if (smallestDiv == -1) {
                // x is prime
                System.out.println(x - 1);
            } else {
                int largestProperDiv = x / smallestDiv;
                System.out.println(x - largestProperDiv);
            }
        }
    }
}