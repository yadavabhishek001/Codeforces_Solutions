import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int t = sc.nextInt();
        for(int i = 0; i<t ;i++){
            String  s= sc.next();
            
            if( s.charAt(0)+s.charAt(1)+s.charAt(2) == s.charAt(3)+s.charAt(4)+s.charAt(5) ){
                System.out.println("YES");
            }
            else{
                System.out.println("NO");
            }
        }
    }
}